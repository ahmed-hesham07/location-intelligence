# Copy to .env and fill in. Never commit .env.

# Copernicus Climate Data Store (ERA5)
CDS_URL=https://cds.climate.copernicus.eu/api
CDS_KEY=

# Copernicus Atmosphere Data Store (CAMS EAC4)
ADS_URL=https://ads.atmosphere.copernicus.eu/api
ADS_KEY=

# Local Postgres + PostGIS (Phase 1)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=locintel
POSTGRES_USER=locintel
POSTGRES_PASSWORD=

# Local RustFS, S3-compatible lake (Phase 1). Keys: 8+ characters.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKETS="raw staged"

# LLM (Phase 10)
LLM_API_KEY=
